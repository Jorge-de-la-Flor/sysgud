  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Status": {
        "type": "string",
        "enum": [
          "pending_approval",
          "executing",
          "executed",
          "failed",
          "rejected"
        ]
      },
      "Event": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Máximo 256 bytes UTF-8; sin caracteres de control"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "description": "Máximo 8192 bytes UTF-8"
          },
          "log_line": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "description": "Alias de message; no enviar ambos"
          }
        },
        "oneOf": [
          {
            "required": [
              "message"
            ],
            "not": {
              "required": [
                "log_line"
              ]
            }
          },
          {
            "required": [
              "log_line"
            ],
            "not": {
              "required": [
                "message"
              ]
            }
          }
        ]
      },
      "Decision": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "actor_id"
        ],
        "properties": {
          "actor_id": {
            "type": "integer",
            "minimum": 1,
            "description": "ID auténtico del usuario Telegram, validado contra la lista de permitidos"
          }
        }
      },
      "Action": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_type",
          "command",
          "diagnosis"
        ],
        "properties": {
          "action_type": {
            "type": "string",
            "enum": [
              "KILL",
              "EXECUTE",
              "NOTIFY",
              "NONE"
            ]
          },
          "command": {
            "type": [
              "string",
              "null"
            ],
            "description": "ID de comando configurado, nunca texto interpretado por shell"
          },
          "diagnosis": {
            "type": "string"
          }
        }
      },
      "CommandSpec": {
        "type": "object",
        "required": [
          "program",
          "args"
        ],
        "additionalProperties": false,
        "properties": {
          "program": {
            "type": "string"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "Incident": {
        "type": "object",
        "required": [
          "id",
          "source",
          "status",
          "severity",
          "diagnosis",
          "proposed_action",
          "execution",

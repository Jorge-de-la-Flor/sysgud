# Copia solo si .env no existe. Nunca publiques este archivo con valores reales.
# Token interno de la API; distinto del token de Telegram.
SYSGUD_BOT_API_TOKEN=
SYSGUD_API_PORT=3000
# Local por defecto; Compose usa 0.0.0.0 dentro del contenedor y publica solo 127.0.0.1.
# SYSGUD_API_HOST=127.0.0.1
SYSGUD_ALLOWED_TELEGRAM_USER_IDS=

# Persistencia y límites.
SYSGUD_DATABASE=.data/sysgud.sqlite
SYSGUD_MAX_INCIDENTS=1000
SYSGUD_CONTEXT_LINES=12
SYSGUD_APPROVAL_TTL_SECONDS=900

# Vacío: solo diagnóstico NOTIFY, sin consultas externas.
ANTHROPIC_API_KEY=
SYSGUD_MODEL=claude-sonnet-5

# Arranca solo la API por defecto en este ejemplo.
SYSGUD_MONITOR_ENABLED=false
# Descomenta para supervisar un proceso. Usa JSON para preservar argumentos.
# SYSGUD_TARGET_CMD=python
# SYSGUD_TARGET_ARGS=["-u","worker.py"]

# EXECUTE está bloqueado hasta configurar IDs con un ejecutable absoluto y args.
# No coloques credenciales en los argumentos. No se interpola texto del LLM.
SYSGUD_COMMANDS_JSON={}

# Bot de la rama telegram, integrado con las aprobaciones de la API.
# Aquí va el token que entrega BotFather.
TELEGRAM_BOT_TOKEN=
SYSGUD_TELEGRAM_ENABLED=false
# Chat PRIVADO del usuario permitido que recibirá nuevos incidentes (opcional).
TELEGRAM_CHAT_ID=
# Alias de la rama original. Si usas ambas listas, deben coincidir.
TELEGRAM_ALLOWLIST=

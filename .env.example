# Copia este archivo a .env (o exporta las variables en tu shell) antes de
# correr `cargo run`. Ninguna es obligatoria: sin ANTHROPIC_API_KEY, sysgud
# sigue funcionando pero el agente siempre responde NOTIFY (modo degradado).

# Clave de la API de Anthropic usada por el motor de decisiones.
ANTHROPIC_API_KEY=

# Modelo a invocar en la API de Messages.
SYSGUD_MODEL=claude-sonnet-5

# Cantidad de líneas que conserva el buffer circular de contexto.
SYSGUD_CONTEXT_LINES=12

# Proceso objetivo a supervisar.
SYSGUD_TARGET_CMD=python3

# Argumentos del proceso objetivo, separados por espacio.
# Por defecto (si se deja vacío) se usa un script de demo que simula un OOM.
SYSGUD_TARGET_ARGS=
